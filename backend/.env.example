# Backend Environment Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Weather API Configuration (Optional: OpenWeatherMap API key)
# If left blank, the system automatically uses Open-Meteo API (free, reliable GPS queries)
# or realistic meteorological fallback simulation for the North Eastern Region.
OPENWEATHER_API_KEY=

# Data Mode: "demo" or "live"
DATA_MODE=demo
